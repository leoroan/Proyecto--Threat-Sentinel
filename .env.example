# ============================================================
# Threat Sentinel - Variables de Entorno
# ============================================================
# Copiar este archivo como .env y ajustar los valores según
# el entorno de despliegue.
# ============================================================

# Puerto del servidor
PORT=3000

# Cadena de conexión a MongoDB
MONGODB_URI=mongodb://localhost:27017/threat-sentinel

# Nombre de la aplicación origen (por defecto)
SOURCE_APPLICATION=threat-sentinel

# Orígenes permitidos para CORS (separados por coma)
# Ejemplo: http://localhost:3001,https://miapp.com
# Vacío o "*" permite todos los orígenes
CORS_ORIGINS=*

# Límite de peticiones por ventana de tiempo (Rate Limiting)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Nivel de log de Morgan (combined, dev, common, short, tiny)
MORGAN_FORMAT=dev

# Días de retención de eventos en MongoDB.
# Los eventos más antiguos se eliminarán automáticamente.
# 0 = sin límite (conservar todos los eventos)
EVENT_RETENTION_DAYS=0

# Trust Proxy para Express.
# true  = confía en todos los proxies (Nginx, Docker, Cloudflare, Kubernetes)
# false = no confía en ningún proxy (desarrollo local)
# número = confía en N proxies consecutivos
# string = lista de IPs/subredes de confianza separadas por coma
TRUST_PROXY=1
